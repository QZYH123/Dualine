{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": false,
    "outDir": "dist-server",
    "rootDir": ".",
    "declaration": true,
    "composite": true,
    "types": ["node"]
  },
  "include": ["server", "scripts", "src/lib/*.ts"],
  "exclude": [
    "src/lib/highlight.ts",
    "src/lib/load.ts",
    "src/lib/clipboard.ts",
    "src/lib/reading-position.ts"
  ]
}
