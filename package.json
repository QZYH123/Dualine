{
  "name": "gloss",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "A dual-pane prose↔code reader: essay on the left, real source on the right.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.server.json",
    "src",
    "server",
    "scripts",
    "examples",
    "tests"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:gloss": "tsx scripts/check-gloss.ts",
    "api": "tsx server/index.ts",
    "dev:all": "concurrently -k -n web,api -c blue,yellow \"npm run dev\" \"npm run api\"",
    "preview:all": "concurrently -k -n web,api -c blue,yellow \"npm run preview\" \"npm run api\"",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && GLOSS_PROJECTS_DIR= npm run check:gloss && npm test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
