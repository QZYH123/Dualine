{
  "name": "gloss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:gloss": "tsx scripts/check-gloss.ts",
    "api": "tsx server/index.ts",
    "dev:all": "concurrently -k -n web,api -c blue,yellow \"npm run dev\" \"npm run api\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
